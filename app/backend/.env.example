# 로컬에서 `uvicorn app.backend.main:app --reload`로 실행할 때 사용하는 예시입니다.
# Docker Compose 환경에서는 저장소 루트의 .env 값을 사용합니다.

# 퀴즈 저장소(MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=investment_db

# 학습 문서 검색(Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=investment_docs

# 선택 사항: RAG 검색 원문만 외부 AI로 문장 정리할 때 설정합니다.
# OpenAI Chat Completions 호환 API의 주소·키·모델을 모두 입력해야 화면에서 선택할 수 있습니다.
# RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_LLM_API_KEY=
# RAG_LLM_MODEL=

# OpenDART 기업·재무 공시 조회용 인증키 (미설정 시 DART API는 503을 반환)
DART_API_KEY=

# 선택 사항: GPU가 있는 환경에서 텍스트-이미지 생성 모델을 바꿀 때만 설정합니다.
# DIFFUSERS_MODEL_ID=runwayml/stable-diffusion-v1-5
